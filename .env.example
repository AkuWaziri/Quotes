# Etherscan API V2 key: needed for verified Solidity source retrieval.
# Keep real keys out of git.
ETHERSCAN_API_KEY=

# HTTPS JSON-RPC endpoint for the chain being scanned.
# The endpoint's eth_chainId is checked against --chain-id before bytecode is read.
QUOTES_RPC_URL=

# Optional HTTPS Slack/Discord-compatible webhook; only used with --notify.
# Treat the webhook URL as a secret and do not commit a real value.
QUOTES_WEBHOOK_URL=
